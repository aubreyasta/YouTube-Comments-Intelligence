{
    "$schema": "https://schema.railpack.com",
    "provider": "python",
    "steps": {
        "install": {
            "commands": [
                {
                    "cmd": "python -m venv /app/.venv"
                },
                {
                    "path": "/app/.venv/bin"
                },
                {
                    "src": "requirements.txt",
                    "dest": "requirements.txt"
                },
                {
                    "src": "requirements-server.txt",
                    "dest": "requirements-server.txt"
                },
                "pip install -r requirements.txt -r requirements-server.txt",
                "PLAYWRIGHT_BROWSERS_PATH=/app/.playwright-browsers python -m playwright install --with-deps chromium"
            ]
        }
    },
    "deploy": {
        "startCommand": "python server.py",
        "variables": {
            "PLAYWRIGHT_BROWSERS_PATH": "/app/.playwright-browsers"
        },
        "aptPackages": [
            "...",
            "libnspr4",
            "libnss3",
            "libdbus-1-3",
            "libatk1.0-0",
            "libatk-bridge2.0-0",
            "libcups2",
            "libdrm2",
            "libxkbcommon0",
            "libxcomposite1",
            "libxdamage1",
            "libxfixes3",
            "libxrandr2",
            "libgbm1",
            "libasound2",
            "libpango-1.0-0",
            "libcairo2",
            "libatspi2.0-0"
        ]
    }
}
